# Azure Game Studio MCP - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# AZURE OPENAI (Required)
# ===========================================
# Get from: Azure Portal > Azure OpenAI > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here

# Model deployments (create these in Azure OpenAI Studio)
AZURE_GPT_DEPLOYMENT_NAME=gpt-4o
AZURE_IMAGE_DEPLOYMENT_NAME=dall-e-3

# ===========================================
# AZURE SORA VIDEO (Optional)
# ===========================================
# For video generation - requires Sora access
AZURE_SORA_DEPLOYMENT_NAME=sora
# Use separate endpoint/key if Sora is in different resource
# AZURE_SORA_ENDPOINT=https://your-sora-resource.openai.azure.com/
# AZURE_SORA_API_KEY=your-sora-api-key

# ===========================================
# AZURE SPEECH (Optional)
# ===========================================
# For voice generation and text-to-speech
# Get from: Azure Portal > Speech Services > Keys and Endpoint
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=eastus

# ===========================================
# FIGMA API (Optional)
# ===========================================
# For Figma design integration
# Get from: Figma > Settings > Personal Access Tokens
FIGMA_ACCESS_TOKEN=your-figma-token-here
